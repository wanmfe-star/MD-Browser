"滚存":{"char":"滚存","kind":"word","pinyin":["gǔn cún"],"definitions":["簿记用语，指逐日累计的积存。"]},"滚开":{"char":"滚开","kind":"word","pinyin":["gǔn kāi"],"definitions":["走开；离开（斥责人的话）。"]},"滚木":{"char":"滚木","kind":"word","pinyin":["gǔn mù"],"definitions":["古代作战时从高处推下以打击敌人的大木头：～礌石。"]},"滚梯":{"char":"滚梯","kind":"word","pinyin":["gǔn tī"],"definitions":["自动扶梯的通称。"]},"滚水":{"char":"滚水","kind":"word","pinyin":["gǔn shuǐ"],"definitions":["正在开着的或刚开过的水：用～冲藕粉。"]},"滚汤泼雪":{"char":"滚汤泼雪","kind":"idiom","pinyin":["gǔn tāng pō xuě"],"definitions":["滚：液体沸腾；汤：开水。沸水倒在冰雪上，雪很快就溶化。形容极为容易。"],"example":"让他来办这件事简直就是～一般。","usage":"作宾语、定语；用于比喻句","similar":"滚汤浇雪"},"滚汤浇雪":{"char":"滚汤浇雪","kind":"idiom","pinyin":["gǔn tāng jiāo xuě"],"definitions":["滚：液体沸腾；汤：开水。沸水倒在冰雪上，雪很快就溶化。形容极为容易，必然成功。"],"source":"清·西周生《醒世姻缘传》第40回：那一肚皮家里怀来的恶意，如滚汤浇雪一般……心中把那恼怒都又变了可怜。","usage":"作宾语、定语；用于比喻句","similar":"滚汤泼雪","opposite":"滚芥投针"},"滚沸":{"char":"滚沸","kind":"word","pinyin":["gǔn fèi"],"definitions":["（液体）沸腾翻滚：一锅～的汤丨；～的感情。"]},"滚滚":{"char":"滚滚","kind":"word","pinyin":["gǔn gǔn"],"definitions":["形容急速地滚动或翻腾：车轮～｜大江～东去｜狂风卷起了～的黄沙；形容连续不断：雷声～｜财源～。"]},"滚滚当潮":{"char":"滚滚当潮","kind":"idiom","pinyin":["gǔn gǔn dāng cháo"],"definitions":["相继不断地掌握政权。"],"example":"中国历史上～的农民政权大部分都是昙花一现。","usage":"作谓语、定语；用于书面语","similar":"滚滚当道"},"滚滚滔滔":{"char":"滚滚滔滔","kind":"idiom","pinyin":["gǔn gǔn tāo tāo"],"definitions":["连续不绝的样子。"],"example":"昔日～的河水已经不复存在，只留下干涸的河道。","usage":"作状语、定语；形容话多","similar":"滔滔不绝"},"滚滚而来":{"char":"滚滚而来","kind":"idiom","pinyin":["gǔn gǔn ér lái"],"definitions":["滚滚：指滔滔流水。形容波涛汹涌连续不断。比喻事物、言谈等连续不断。"],"source":"唐·杜甫《登高》诗：无边落木萧萧下，不尽长江滚滚来。","usage":"作谓语；指来势状态","example":"明·周楫《西湖二集·巧书生金銮失对》：甄龙友日常问一答十，问十答百之口，～，不知此时怎么就……一句也答不出来。"},"滚烫":{"char":"滚烫","kind":"word","pinyin":["gǔn tàng"],"definitions":["状态词。滚热。"]},"滚热":{"char":"滚热","kind":"word","pinyin":["gǔn rè"],"definitions":["状态词。非常热（多指饮食或体温）：喝一杯～的茶｜他额头～，可能是发烧了。"],"similar":"滚烫","opposite":"冰凉"},"滚珠":{"char":"滚珠","kind":"word","pinyin":["gǔn zhū"],"definitions":["（～儿）；钢制的圆珠形零件。"]},"滚瓜流水":{"char":"滚瓜流水","kind":"idiom","pinyin":["gǔn guā liú shuǐ"],"definitions":["形容说话极其熟练、流利。"],"source":"茅盾《霜叶红似二月花》五：他得意地哈了一声就滚瓜流水地一口气说道：‘说是男女在那件事上也该平等。’","usage":"作定语、状语；用于说话等","similar":"滚瓜烂熟；滚瓜溜油"},"滚瓜溜圆":{"char":"滚瓜溜圆","kind":"idiom","pinyin":["gǔn guā liū yuán"],"definitions":["指非常圆，滚圆。"],"source":"他养的猪头头～。","example":"他养的猪头头～","usage":"作谓语、定语、状语；用于口语"},"滚瓜溜油":{"char":"滚瓜溜油","kind":"idiom","pinyin":["gǔn guā liū yóu"],"definitions":["形容背得非常熟练。"],"source":"清·蒲松龄《东郭外传》：做的有枝有叶，念的滚瓜溜油。","usage":"作定语、状语；用于说话等","similar":"滚瓜烂熟；滚瓜流水"},"滚瓜烂熟":{"char":"滚瓜烂熟","kind":"idiom","pinyin":["gǔn guā làn shú"],"definitions":["象从瓜蔓上掉下来的瓜那样熟。形容读书或背书流利纯熟。"],"source":"清·吴敬梓《儒林外史》第十一回：十一二岁就讲书、读文章，先把一部王守溪的稿子读的滚瓜烂熟。","usage":"作补语、定语、状语；指读书方面","similar":"倒背如流；驾轻就熟","opposite":"半生半熟；吞吞吐吐","example":"端木蕻良《曹雪芹》四：曹寅从小对唐诗就背得～。"},"滚石上山":{"char":"滚石上山","kind":"word","pinyin":["gǔn shí shàng shān"],"definitions":["比喻迎难而上、坚持不懈才能成功，不然就会前功尽弃。"]},"滚筒":{"char":"滚筒","kind":"word","pinyin":["gǔn tǒng"],"definitions":["机器上能转动的圆筒形机件：～洗衣机。"]},"滚翻":{"char":"滚翻","kind":"word","pinyin":["gǔn fān"],"definitions":["体操动作，全身向前、向后或向侧翻转：前～｜后～。"]},"滚肥":{"char":"滚肥","kind":"word","pinyin":["gǔn féi"],"definitions":["状态词。非常肥（多指动物）：这头猪喂得～～的。"]},"滚芥投针":{"char":"滚芥投针","kind":"idiom","pinyin":["gǔn jiè tóu zhēn"],"definitions":["滚动芥耔把针投到小孔里。比喻事情进展缓慢，成效很小。"],"source":"明·许仲琳《封神演义》第十五回：修行虽是滚芥投针，……弟子情愿在山苦行。","usage":"作宾语、定语；用于做事","opposite":"滚汤浇雪"},"滚蛋":{"char":"滚蛋","kind":"word","pinyin":["gǔn dàn"],"definitions":["离开；走开（斥责或骂人的话）。"]},"滚轮":{"char":"滚轮","kind":"word","pinyin":["gǔn lún"],"definitions":["运动器械的一种，由若干铁棍平行连接两个大小相同的铁环制成。人在轮里手攀脚蹬，使环滚动。旧称虎伏。"]},"滚边":{"char":"滚边","kind":"word","pinyin":["gǔn biān"],"definitions":[],"similar":"绲边"},"滚雪球":{"char":"滚雪球","kind":"idiom","pinyin":["gǔn xuě qiú"],"definitions":["雪球在雪中滚动，越滚越大。比喻越活动越发展的事物。"],"example":"我们用～的办法逐步积累资金。","usage":"作宾语、定语；用于事物等"},"滚雷":{"char":"滚雷","kind":"word","pinyin":["gǔn léi"],"definitions":["声音连续不断的雷；从高处滚放的能延时爆炸的地雷。"]},"滚鞍下马":{"char":"滚鞍下马","kind":"idiom","pinyin":["gǔn ā