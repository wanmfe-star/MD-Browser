上加错":{"char":"错上加错","kind":"idiom","pinyin":["cuò shàng jiā cuò"],"definitions":["本来已经错了，又犯了新的错误。"]},"错乱":{"char":"错乱","kind":"word","pinyin":["cuò luàn"],"definitions":["无次序；失常态：颠倒～｜精神～。"]},"错会":{"char":"错会","kind":"word","pinyin":["cuò huì"],"definitions":["错误地理解：你～了我的意思。"]},"错位":{"char":"错位","kind":"word","pinyin":["cuò wèi"],"definitions":["离开原来的或应有的位置：骨关节～；比喻失去正常的或应有的状态：名利使他的荣辱观发生了～。"]},"错别字":{"char":"错别字","kind":"word","pinyin":["cuò bié zì"],"definitions":["错字和别字。"]},"错叠":{"char":"错叠","kind":"word","pinyin":["cuò dié"],"definitions":["交错重叠在一起．山石～。"]},"错告":{"char":"错告","kind":"word","pinyin":["cuò gào"],"definitions":["由于对情况了解不确实或认识上的片面性，向有关部门作了不符合实情的告发。"]},"错处":{"char":"错处","kind":"word","pinyin":["cuò chǔ"],"definitions":["错误的地方；过错。"]},"错失":{"char":"错失","kind":"word","pinyin":["cuò shī"],"definitions":["错过；失去：～良机；差错；过失：他工作认真负责，没有发生过～。"]},"错字":{"char":"错字","kind":"word","pinyin":["cuò zì"],"definitions":["写得不正确的字或刻错、排错的字。"]},"错季":{"char":"错季","kind":"word","pinyin":["cuò jì"],"definitions":["错开季节：如今种菜讲究～。"]},"错层":{"char":"错层","kind":"word","pinyin":["cuò céng"],"definitions":["指一套住宅内部空间层次不在一个平面上，错开的地方有台阶连通的建筑形式：～住宅。"]},"错峰":{"char":"错峰","kind":"word","pinyin":["cuò fēng"],"definitions":["（用水、用电、车辆运行等）错开高峰时段：用电大户可以～安排生产｜～出行以缓解道路拥堵。"]},"错开":{"char":"错开","kind":"word","pinyin":["cuò kāi"],"definitions":["（时间、位置）互相让开，避免冲突：为了避免公共车辆的拥挤，工厂、机关上下班的时间最好～。"]},"错彩镂金":{"char":"错彩镂金","kind":"idiom","pinyin":["cuò cǎi lòu jīn"],"definitions":["错：涂饰；镂：雕刻。形容诗文的词藻十分华丽。"],"source":"南朝·梁·钟嵘《诗品》卷中：谢诗如芙蓉出水，颜如错彩镂金。","usage":"作定语、宾语；形容诗文的词藻十分华丽","similar":"精雕细刻；镂金错彩"},"错待":{"char":"错待","kind":"word","pinyin":["cuò dài"],"definitions":["亏待：他不会～你，你放心好了。"]},"错怪":{"char":"错怪","kind":"word","pinyin":["cuò guài"],"definitions":["因误会而错误地责备或抱怨人：是我不了解情况，～了你。"]},"错愕":{"char":"错愕","kind":"word","pinyin":["cuò è"],"definitions":["仓促间感到惊愕：他的突然到来使她大为～。"]},"错时":{"char":"错时","kind":"word","pinyin":["cuò shí"],"definitions":["错开时间：要求各单位～上下班，缓解市区交通拥堵状况。"]},"错杂":{"char":"错杂","kind":"word","pinyin":["cuò zá"],"definitions":["两种以上的东西夹杂在一起：颜色～。"]},"错案":{"char":"错案","kind":"word","pinyin":["cuò àn"],"definitions":["错判的案件。"]},"错漏":{"char":"错漏","kind":"word","pinyin":["cuò lòu"],"definitions":["错误和遗漏：文稿誊清后请再核对一遍，以免～。"]},"错爱":{"char":"错爱","kind":"word","pinyin":["cuò ài"],"definitions":["谦辞，表示感谢对方对自己的爱护。"]},"错版":{"char":"错版","kind":"word","pinyin":["cuò bǎn"],"definitions":["指邮品、纸币等出现的排印错误的版面：～邮票。"]},"错综":{"char":"错综","kind":"word","pinyin":["cuò zōng"],"definitions":["纵横交叉：～复杂｜公路～｜枝叶～，繁花似锦。"]},"错综变化":{"char":"错综变化","kind":"idiom","pinyin":["cuò zōng biàn huà"],"definitions":["形容头绪纷繁，变化多端。"],"source":"清·刘熙载《艺概·文概》：惟能线索在手，则错综变化，惟吾所施。","usage":"作谓语、宾语；指变化多端","similar":"变幻莫测","opposite":"一成不变"},"错综复杂":{"char":"错综复杂","kind":"idiom","pinyin":["cuò zōng fù zá"],"definitions":["错：交错，交叉；综：合在一起。形容头绪多，情况复杂。"],"source":"《周易·系辞上》：参伍以变，错综其数。","usage":"作谓语、定语；形容斗争、矛盾等","similar":"扑朔迷离；盘根错节；纵横交错","opposite":"井然有序；一目了然","example":"秦牧《河汊错综》：不管形式上怎样～，变化诡奇，实际上总有一个基本的道理贯串其间。"},"错节盘根":{"char":"错节盘根","kind":"idiom","pinyin":["cuò jié pán gēn"],"definitions":["错：交错；节：枝节；盘：盘曲。树木的根枝盘旋交错。①比喻事情纷难复杂。②形容人坚韧不拔。"],"source":"《后汉书·虞诩传》：志不求易，事不避难，臣之职也；不遇盘根错节，何以别利器乎？","usage":"作谓语、宾语、定语；比喻事情复杂","similar":"盘根错节","example":"宋·张孝祥《赵通判》：光风霁月，自是无尘，～，试规游刃。"},"错落":{"char":"错落","kind":"word","pinyin":["cuò luò"],"definitions":["交错纷杂：～有致｜～不齐｜苍松翠柏，～其间。"]},"错落不齐":{"char":"错落不齐","kind":"idiom","pinyin":["cuò luò bù qí"],"definitions":["形容极不整齐。"],"source":"汉·班固《西都赋》：“随侯明月，错落其间。”《晋书·卫恒传》：纤波浓点，错落期间。","usage":"作谓语、定语；形容不整齐","similar":"参差不齐","opposite":"错落有致","example":"叶圣陶《皮包》：十多封来信……开口处～，是随手撕的。"},"错落参差":{"char":"错落参差","kind":"idiom","pinyin":["cuò luò cēn cī"],"definitions":["交错不齐。同“参差错落”。"],"source":"清·百一居士《壶天录》卷下：一骑在前，数骑在后……乃未及半圈，而前者忽后，后者忽前，错落参差，捉摸不定，使人目眩神骇。","usage":"作谓语、定语；指交错不齐","similar":"参差错落；参差不齐","opposite":"整齐划一；整整齐齐"},"错落有致":{"char":"错落有致","kind":"idiom","pinyin":["cuò luò yǒu zhì"],"definitions":["错落：参差不齐。致：情趣。形容事物的布局虽然参差不齐，但却极有情趣，使人看了有好感。"],"source":"《晋书·卫恒》：纤波浓点，错落其间。","usage":"作谓语、定语、补语；指事物布局合理可爱","similar":"有条不紊；有条有理","opposite":"杂乱无章；错落不齐","example":"叶圣陶《游了三个湖》：外湖跟里湖从～的枝叶间望去，似乎时刻在变换模样儿。"},"错落高下":{"char":"错落高下","kind":"idiom","pinyin":["cuò luò gāo xià"],"definitions":["犹言长短高低。"],"source":"宋·叶適《文林郎前秘书省正字周君南仲墓志铭》：已而耳改目化，气竦神涌，古今事物，错落高下，不以涯量。","usage":"作谓语、定语；用于秩序等","similar":"错落参差"},"错觉":{"char":"错觉","kind":"word","pinyin":["cuò jué"],"definitions":["由于某种原因引起的对客观事物的不正确的知觉。如筷子放在有水的碗内，由于光线折射，看起来筷子是弯的，就是一种错觉。"]},"错认颜标":{"char":"错认颜标","kind":"idiom","pinyin":["cuò rèn yán biāo"],"definitions":["形容懵懂浅陋。"],"source":"五代·王定保《唐摭言》卷八：主司头脑太冬烘，错认颜标作鲁公。","usage":"作谓语、定语；指头脑不清醒"},"错讹":{"char":"错讹","kind":"word","pinyin":["cuò é"],"definitions":["（文字、记载）错误：校对不严，～甚多。"]},"错误":{"char":"错误","kind":"word","pinyin":["cuò wù"],"definitions":["不正确；与客观实际不符合：～思想｜～的结论；不正确的事物、行为等：犯～｜改正～。"],"similar":"错处；谬误；缺点","opposite":"正确"},"错谬":{"char":"错谬","kind":"word","pinyin":["cuò miù"],"definitions":["错误；差错：～之处，请多指正。"]},"错车":{"char":"错车","kind":"word","pinyin":["cuò chē"],"definitions":["火车、电车、汽车等在单轨上或窄路上相向行驶，或后车超越前车时，在铺设双轨的地方或路边让开，使双方顺利通行。"]},"错过":{"char":"错过","kind":"word","pinyin":["cuò guò"],"definitions":["失去（时机、对象）：不要～农时｜～这个村就没有那个店了。"]},"错过时机":{"char":"错过时机","kind":"idiom","pinyin":["cuò guò shí jī"],"definitions":["丧失机会。"],"example":"我们不能～，把胜利果实让给对方。","usage":"作谓语、宾语；指丧失机会","similar":"错过良机","opposite":"不失时机"},"错金":{"char":"错金","kind":"word","pinyin":["cuò jīn"],"definitions":["特种工艺的一种，在器物上用金属丝镶嵌成花纹或文字。"]},"错银":{"char":"错银","kind":"word","pinyin":["cuò yín"],"definitions":["特种工艺的一种，在器物上用银丝镶嵌成花纹或文字。"]},"错非":{"char":"错非","kind":"word","pinyin":["cuò fēi"],"definitions":["除非；除了：～这种药，别的药治不了他的病。"]},"阙一不可":{"char":"阙一不可","kind":"idiom","pinyin":["què yī bù kě"],"definitions":["两种以上因素中，缺少哪一种也不行。"],"source":"《宋史·岳飞传》：善以少击众。欲有所举，尽召诸统制与谋，谋定而后战，故有胜无败。猝遇敌不动，故敌为之语曰：‘撼山易，撼岳家军难。’张俊尝问用兵之术，曰：‘仁、智、信、勇、严，阙一不可。’","example":"《曾国藩家书》：古之成大事者，规模远大与综理密微，二者～。"},"阙下":{"char":"阙下","kind":"word","pinyin":["què xià"],"definitions":["宫阙之下。借指帝王所居的宫廷； 借指京城。"]},"阙乏":{"char":"阙乏","kind":"word","pinyin":["quē fá"],"definitions"