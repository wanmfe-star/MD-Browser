"definitions":["亦作\"绵纩\"； 丝绵； 借指絮丝棉的衣服。"]},"绵纸":{"char":"绵纸","kind":"word","pinyin":["mián zhǐ"],"definitions":["亦作\"绵纸\"； 一种用树木的韧皮纤维制成的纸。色白柔韧，纤维细长如绵，故称。"]},"绵绒":{"char":"绵绒","kind":"word","pinyin":["mián róng"],"definitions":[],"similar":"绵绒"},"绵络":{"char":"绵络","kind":"word","pinyin":["mián luò"],"definitions":["亦作\"绵络\"； 缠绕;网络； 连续;连绵。"]},"绵绵":{"char":"绵绵","kind":"word","pinyin":["mián mián"],"definitions":["连续不断的样子：秋雨～｜情意～。"],"similar":"连绵；绵长；绵延；连续","opposite":"间断；间隔"},"绵绵不息":{"char":"绵绵不息","kind":"idiom","pinyin":["mián mián bù xī"],"definitions":["绵绵：连续不断的样子。延续不断。"],"source":"《孔子家语·观周》：涓涓不壅，终为江河，绵绵不绝，或成网罗。","usage":"作谓语、定语、状语；指连续不断","similar":"绵绵不绝","opposite":"断断续续；一刀两断","example":"巴金《无题·做一个战士》：我激荡在这～、滂沱四方的生命洪流中。"},"绵绵不断":{"char":"绵绵不断","kind":"idiom","pinyin":["mián mián bù duàn"],"definitions":["绵绵：延续不绝的样子。接连不断，一直延续下去。亦作“绵绵不息”、“绵绵不绝”、“绵延不绝”。"],"source":"《孔子家语·观周》：涓涓不壅，终为江河，绵绵不绝，或成网罗。","usage":"作定语、状语；用于口语","similar":"连续不断","opposite":"断断续续","example":"魏巍《地球的红飘带》二十：天色灰蒙蒙的，弥漫的云雾遮盖着山峦，那种无尽无休的贵州式的细雨～。"},"绵绵不绝":{"char":"绵绵不绝","kind":"idiom","pinyin":["mián mián bù jué"],"definitions":["绵绵：连续不断的样子。形容多，连续不断。"],"source":"三国·魏·王肃《孔子家语·观周》：涓涓不壅，终为江河，绵绵不绝，或成网罗。","usage":"作谓语、定语、状语；指连续不断","similar":"接连不断；连绵不断","opposite":"断断续续；一刀两断","example":"《警世通言·白娘子永镇雷峰塔》：正是清明时节，少不得天公应时，催花雨下，那阵雨下得～。"},"绵绵不绝,缦缦奈何":{"char":"绵绵不绝,缦缦奈何","kind":"idiom","pinyin":["mián mián bù jué，màn màn nài hé"],"definitions":["缦：通“蔓”。事端在微小的时候如不杜绝，蔓延起来怎么办？形容错误或坏事在其萌芽状态时就要根除，不让其发展下去，赞成祸患。"],"source":"《战国策·魏策一》：绵绵不绝，缦缦奈何；毫毛不拔，将成斧柯。"},"绵绵瓜瓞":{"char":"绵绵瓜瓞","kind":"idiom","pinyin":["mián mián guā dié"],"definitions":["绵绵：延续不断的样子；瓞：小瓜。如同一根连绵不断的藤上结了许多大大小小的瓜一样。引用为祝颂子孙昌盛。"],"source":"《诗经·大雅·绵》：绵绵瓜瓞，民之初生，自土沮漆。","usage":"作宾语、定语；指子孙昌盛","example":"晋·潘岳《为贾谧作赠陆机》诗：夏殷既袭，宗周继祀，～，六国互峙。"},"绵绵缗缗":{"char":"绵绵缗缗","kind":"idiom","pinyin":["mián mián mín mín"],"definitions":["绵绵：连绵不断的样子。连绵不断的样子。"],"source":"清·梅曾亮《盋山余霞阁记》：其东南万屋沉沉，炊烟如人立，各有所企，微风绕之，左引右挹。绵绵缗缗。","usage":"作定语、状语；用于书面语"},"绵绸":{"char":"绵绸","kind":"word","pinyin":["mián chóu"],"definitions":["亦作\"绵緄\"； 用残次茧丝经过加工处理纺成绸丝所织的平纹绸。织物表面不光整，但厚实坚牢。"]},"绵缀":{"char":"绵缀","kind":"word","pinyin":["mián zhuì"],"definitions":[],"similar":"绵惙"},"绵缠":{"char":"绵缠","kind":"word","pinyin":["mián chán"],"definitions":["犹缠绵。谓久病不愈。"]},"绵羃":{"char":"绵羃","kind":"word","pinyin":["mián mì"],"definitions":[],"similar":"绵幂"},"绵羊":{"char":"绵羊","kind":"word","pinyin":["mián yáng"],"definitions":["脊椎动物，哺乳纲，偶蹄目，牛科。反刍家畜。体丰满，被毛绵密，多白色。头短，公羊多有螺旋状大角，母羊无角或角细小。四肢强健。尾型不一，有长瘦尾、脂尾、短尾、肥尾之分。寿命约十五年。以温带、寒带分布最多。主要用于产毛和肉。"]},"绵羽":{"char":"绵羽","kind":"word","pinyin":["mián yǔ"],"definitions":["亦作\"绵羽\"； 《诗．小雅．绵蛮》\"绵蛮黄鸟，止于丘阿。\"以\"绵蛮\"形容黄鸟，后因以\"绵羽\"为黄鸟之别称。"]},"绵联":{"char":"绵联","kind":"word","pinyin":["mián lián"],"definitions":["亦作\"绵联\"。亦作\"绵连\"； 犹连绵。延续不断貌； 屋檐的别名。"]},"绵花":{"char":"绵花","kind":"word","pinyin":["mián huā"],"definitions":["亦作\"绵花\"； 即棉花。绵，通\"棉\"。"]},"绵茧":{"char":"绵茧","kind":"word","pinyin":["mián jiǎn"],"definitions":["吴俗称囊头。指质量较差的茧子。"]},"绵药":{"char":"绵药","kind":"word","pinyin":["mián yào"],"definitions":["古代两广少数民族所用的毒箭。亦称\"眠药\"。"]},"绵蒙":{"char":"绵蒙","kind":"word","pinyin":["mián méng"],"definitions":["幽暗不明貌。"]},"绵蕝":{"char":"绵蕝","kind":"word","pinyin":["mián jué"],"definitions":[],"similar":"绵蕞"},"绵蕞":{"char":"绵蕞","kind":"word","pinyin":["mián zuì"],"definitions":["亦作\"绵蕞\"。亦作\"绵蕝\"。亦作\"绵蕝\"； 据《史记．刘敬叔孙通列传》载，叔孙通欲为汉高祖创立朝仪，使征鲁诸生三十馀人，叔孙通\"遂与所征三十人西，及上左右为学者与其弟子百余人为绵蕞野外\"，习肄月馀始成。按，引绳为\"绵\"，束茅以表位为\"蕞\"◇因谓制订整顿朝仪典章为\"绵蕞\"或\"绵蕝\"； 引申指经营创建； 借指表率。"]},"绵薄":{"char":"绵薄","kind":"word","pinyin":["mián báo"],"definitions":["谦称自己的能力很薄弱稍尽绵薄｜愿效绵薄。"]},"绵薭":{"char":"绵薭","kind":"word","pinyin":["mián bài"],"definitions":[],"similar":"绵暧"},"绵蛮":{"char":"绵蛮","kind":"word","pinyin":["mián mán"],"definitions":["亦作\"绵蛮\"； 《诗．小雅．绵蛮》\"绵蛮黄鸟，止于丘阿。\"毛传\"绵蛮，小鸟貌。\"朱熹集传\"绵蛮，鸟声。\"王国维《观堂集林．尔雅草木虫鱼鸟兽名释例下》\"虫之小者曰蠛蒙，鸟之小者亦曰绵蛮，殆皆微字之音转。\"《文选．何晏》\"绵蛮黮?。\"李善注\"《韩诗》曰'绵蛮黄鸟'，薛君曰'绵蛮，文貌。'\"历来诗文中多用小鸟﹑鸟声二说。指小鸟或鸟鸣声。"]},"绵衣":{"char":"绵衣","kind":"word","pinyin":["mián yī"],"definitions":["亦作\"绵衣\"； 内装丝绵的衣服； 指装棉絮的衣服。绵，通\"棉\"。"