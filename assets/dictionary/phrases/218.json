nitions":["蟋蟀。亦指蟋蟀声。"]},"觚不觚":{"char":"觚不觚","kind":"word","pinyin":["gū bù gū"],"definitions":["比喻事物名实不符。语出《论语．雍也》\"子曰'觚不觚，觚哉！觚哉!'\"何晏集解\"以喻为政不得其道，则不成。\"朱熹集注\"觚，棱也;或曰酒器，或曰木简，皆器之有棱者也。不觚者，盖当时失其制而不为棱也。觚哉觚哉！言不得为觚也。\""]},"觚卢":{"char":"觚卢","kind":"word","pinyin":["gū lú"],"definitions":["即葫芦。《汉书．司马相如传上》\"东蘠雕胡，莲藕觚卢。\"颜师古注引张晏曰\"觚卢，扈鲁也。\"王先谦补注\"觚卢，即瓠?。觚卢﹑瓠?﹑扈鲁，并一声之转。\"一说，是菰茭(菰米的嫩茎)和芦笋。《史记．司马相如列传》作\"菇芦\"。"]},"觚圜":{"char":"觚圜","kind":"word","pinyin":["gū huán"],"definitions":["方圆。"]},"觚坛":{"char":"觚坛","kind":"word","pinyin":["gū tán"],"definitions":["有棱角的祭坛。"]},"觚廉":{"char":"觚廉","kind":"word","pinyin":["gū lián"],"definitions":["棱角。"]},"觚木":{"char":"觚木","kind":"word","pinyin":["gū mù"],"definitions":["古代书写用的木简。"]},"觚棱":{"char":"觚棱","kind":"word","pinyin":["gū léng"],"definitions":[],"similar":"觚棱"},"觚椠":{"char":"觚椠","kind":"word","pinyin":["gū qiàn"],"definitions":["古代用木削成以备书写的简牍。"]},"觚牍":{"char":"觚牍","kind":"word","pinyin":["gū dú"],"definitions":["供书写的木简。亦指书翰。"]},"觚竹":{"char":"觚竹","kind":"word","pinyin":["gū zhú"],"definitions":["古国名。觚，通\"孤\"。"]},"觚简":{"char":"觚简","kind":"word","pinyin":["gū jiǎn"],"definitions":["古代书写用的木简。借指书籍； 引申为刻印书籍。"]},"觚编":{"char":"觚编","kind":"word","pinyin":["gū biān"],"definitions":["编连成册的木简。借指书籍。"]},"觚翰":{"char":"觚翰","kind":"word","pinyin":["gū hàn"],"definitions":["木简与笔。借指文辞。"]},"觚角":{"char":"觚角","kind":"word","pinyin":["gū jiǎo"],"definitions":["锋芒;棱角。"]},"觚陛":{"char":"觚陛","kind":"word","pinyin":["gū bì"],"definitions":["棱角整齐的台阶。借指坛场。"]},"诚信":{"char":"诚信","kind":"word","pinyin":["chéng xìn"],"definitions":["诚实，守信用：明礼～｜生意人应当以～为本。"]},"诚厚":{"char":"诚厚","kind":"word","pinyin":["chéng hòu"],"definitions":["诚实宽厚。"]},"诚如":{"char":"诚如","kind":"word","pinyin":["chéng rú"],"definitions":["确实如同：～阁下所言。"]},"诚实":{"char":"诚实","kind":"word","pinyin":["chéng shí"],"definitions":["言行跟内心思想一致（指好的思想行为）；不虚假：这孩子很～，不会撒谎。"],"similar":"忠诚；老实","opposite":"虚假；虚伪"},"诚归":{"char":"诚归","kind":"word","pinyin":["chéng guī"],"definitions":["诚心回归。"]},"诚当":{"char":"诚当","kind":"word","pinyin":["chéng dāng"],"definitions":["正值。"]},"诚心":{"char":"诚心","kind":"word","pinyin":["chéng xīn"],"definitions":["诚恳的心意：一片～；诚恳：我们～向您求教。"]},"诚心实意":{"char":"诚心实意","kind":"idiom","pinyin":["chéng xīn shí yì"],"definitions":["形容十分真挚诚恳。"],"source":"明·王守仁《传习录》中卷：而其诚心实意之所在，以为不如是则无以济其私而满其欲也。","usage":"作宾语、定语、状语；指真诚","similar":"真心实意；诚心诚意","opposite":"三心二意","example":"姚雪垠《长夜》：他～地想要你跟他过日子。"},"诚心敬意":{"char":"诚心敬意","kind":"idiom","pinyin":["chéng xīn jìng yì"],"definitions":["形容对人十分真诚和有礼貌。"],"source":"明·无名氏《下西洋》第三折：你道是诚心敬意亲呈进，俺那里知重知轻在您行。","usage":"作宾语、定语、状语；用于为人","similar":"诚心实意"},"诚心正意":{"char":"诚心正意","kind":"idiom","pinyin":["chéng xīn zhèng yì"],"definitions":["诚：真诚。心意真诚恳切。形容对人十分真挚诚恳。亦作“诚心诚意”。"],"source":"元·宫大用《范张鸡黍》第一折：皇天有意为斯文，教人从诚心正意修根本，以至齐家治国为标准。","usage":"作宾语、定语、状语；用于为人","similar":"诚心实意","example":"明·无名氏《孟母三移》第四折：则为他治国齐家存妙策，～请贤臣。"},"诚心诚意":{"char":"诚心诚意","kind":"idiom","pinyin":["chéng xīn chéng yì"],"definitions":["形容十分真挚诚恳。"],"source":"《后汉书·马援传》：开心见诚，无所隐伏。","usage":"作谓语、宾语、定语；指十分真挚","similar":"真心实意","opposite":"虚情假意","example":"清·曹雪芹《红楼梦》第六回：大远的～来了，岂有个不叫你见个真佛儿去的呢？"},"诚必":{"char":"诚必","kind":"word","pinyin":["chéng bì"],"definitions":["谓遵守信用﹐说到做到。"]},"诚怀":{"char":"诚怀","kind":"word","pinyin":["chéng huái"],"definitions":["诚心﹔真诚的情怀。"]},"诚恐诚惶":{"char":"诚恐诚惶","kind":"idiom","pinyin":["chéng kǒng chéng huáng"],"definitions":["诚：确实；惶：害怕。惶恐不安。指非常小心谨慎以至于惶恐不安。"],"source":"明·汤显祖《南柯记·朝议》：念臣棼诚恐诚惶，壍江城遭寇与拦当。","usage":"作谓语、定语、状语；带有幽默或讽刺","similar":"诚惶诚恐；诚惶诚惧"},"诚恳":{"char":"诚恳","kind":"word","pinyin":["chéng kěn"],"definitions":["真诚而恳切：态度～｜言出肺腑，～感人。"],"similar":"恳切；真诚","opposite":"虚伪"},"诚惶":{"char":"诚惶","kind":"word","pinyin":["chéng huáng"],"definitions":[],"similar":"诚惶诚恐"},"诚惶诚恐":{"char":"诚惶诚恐","kind":"idiom","pinyin":["chéng huáng chéng kǒng"],"definitions":["诚：实在，的确；惶：害怕；恐：畏惧。非常小心谨慎以至达到害怕不安的程度。"],"source":"汉·杜诗《乞退郡疏》：奉职无效，久窃禄位，令功臣怀愠，诚惶诚恐。","usage":"作谓语、定语、状语；带有幽默或讽刺","similar":"惊惶失措；惶恐不安；胆战心惊","opposite":"处之泰然","example":"郭沫若《北伐途中》二十一：一些成了惊弓之鸟的部员们算也～地先后把那段危险的地面通过了。"},"诚惶诚惧":{"c