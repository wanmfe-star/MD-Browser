inyin":["qián zi"],"definitions":["即毽子。"]},"揵扑":{"char":"揵扑","kind":"word","pinyin":["qián pū"],"definitions":["犹剪灭。"]},"揵搣":{"char":"揵搣","kind":"word","pinyin":["qián miè"],"definitions":["按摩。《急就篇》卷三\"沐浴揵搣寡合同。\"见《说文解字．手部》\"揵\"字注。一说谓剃拔眉发。颜师古注\"揵搣，谓k拔眉发也。盖去其不整齐者。\""]},"揵毒":{"char":"揵毒","kind":"word","pinyin":["qián dú"],"definitions":["急速。"]},"揵落":{"char":"揵落","kind":"word","pinyin":["qián luò"],"definitions":["犹灭亡。"]},"棵儿":{"char":"棵儿","kind":"word","pinyin":["kē ér"],"definitions":["植株大小的程度：这棵花～小｜拣～大的菜拔。"]},"棵子":{"char":"棵子","kind":"word","pinyin":["kē zi"],"definitions":["〈方〉植物的茎和枝叶（多指庄稼的）青～ㄧ树～ㄧ玉米～长得很高。"]},"棵把":{"char":"棵把","kind":"word","pinyin":["kē bǎ"],"definitions":["指成束的农作物植株。"]},"棵松":{"char":"棵松","kind":"word","pinyin":["kē sōng"],"definitions":["五粒松。"]},"棵秆":{"char":"棵秆","kind":"word","pinyin":["kē gǎn"],"definitions":["某些植物的茎。"]},"槵子":{"char":"槵子","kind":"word","pinyin":["huàn zi"],"definitions":["无患木的籽实。可制念珠。"]},"毵娑":{"char":"毵娑","kind":"word","pinyin":["sān suō"],"definitions":["亦作\"嬫\"； 垂拂纷披貌。"]},"毵毵":{"char":"毵毵","kind":"word","pinyin":["sān sān"],"definitions":["毛发、枝条等细长的样子：～下垂｜柳枝～。"]},"毵珊":{"char":"毵珊","kind":"word","pinyin":["sān shān"],"definitions":["须发长而卷曲貌。"]},"緵罟":{"char":"緵罟","kind":"word","pinyin":["zōng gǔ"],"definitions":["网眼细密的鱼网。"]},"绵上":{"char":"绵上","kind":"word","pinyin":["mián shàng"],"definitions":["古地名。春秋晋地。在今山西省介休县东南四十里介山之下。公元前636年，介之推隐于绵上山中而死，晋文公求之不获，遂以绵上之田作为介之推的祭田。见《左传．僖公二十四年》。"]},"绵丽":{"char":"绵丽","kind":"word","pinyin":["mián lì"],"definitions":["亦作\"绵丽\"； 犹靡丽。多形容词藻华美。"]},"绵亘":{"char":"绵亘","kind":"word","pinyin":["mián gèn"],"definitions":["延续不断；延伸绵亘千里｜绵亘不绝｜峰峦绵亘。"]},"绵代":{"char":"绵代","kind":"word","pinyin":["mián dài"],"definitions":["亦作\"绵代\"； 犹言世世代代。"]},"绵侧理":{"char":"绵侧理","kind":"word","pinyin":["mián cè lǐ"],"definitions":["纸名。即侧理纸。旧时南人用海苔制纸，其纹理纵横斜侧，因以为名。见晋王嘉《拾遗记．晋时事》。"]},"绵剧":{"char":"绵剧","kind":"word","pinyin":["mián jù"],"definitions":["亦作\"绵剧\"； 谓病势缠绵加剧。"]},"绵力":{"char":"绵力","kind":"word","pinyin":["mián lì"],"definitio