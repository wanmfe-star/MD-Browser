iom","pinyin":["hàn tiān zhèn dì"],"definitions":["撼：摇动；震：震动。震动了天地。形容声音或声势极大。"],"source":"《三国志·魏志·文帝纪》裴松之注：“惟黄初七年五月七日，大行皇帝崩，呜呼哀哉！于时天震地骇。”《水经注·河水》：涛涌波襄，雷奔电泄，震天动地。","usage":"作谓语、定语；形容声音或声势极大","similar":"惊天动地","example":"清·曾朴《孽海花》第二十三回：一语未了，不提防西边树林里，陡起了一阵～的狂风，飞沙走石，直向东边路上刮剌剌的卷去。"},"撼山拔树":{"char":"撼山拔树","kind":"idiom","pinyin":["hàn shān bá shù"],"definitions":["摇动山岳，拔起树木。形容威势之大。"],"source":"明·李唐宾《梧桐叶》第二折：风呵，兀的不傒幸杀人也，方才撼山拔树，飞沙走石般起，投至央及你，可倒定息了。","usage":"作谓语、定语；用于势力等"},"撼树蚍蜉":{"char":"撼树蚍蜉","kind":"idiom","pinyin":["hàn shù bí fú"],"definitions":["撼：摇动。蚍蜉：大蚂蚁。想把大树摇动的大蚂蚁。比喻自不量力者。"],"source":"唐·韩愈《调张籍》诗：蚍蜉撼大树，可笑不自量。","usage":"作宾语；指自不量力者","similar":"蚍蜉撼树","example":"清·洪楝园《后南柯·伐檀》：应变若机张，马策元驹，车抗螳螂，撼树蚍蜉，更分遣随营相向。"},"於乎":{"char":"於乎","kind":"word","pinyin":["yú hū"],"definitions":[],"similar":"呜呼"},"於乎哀哉":{"char":"於乎哀哉","kind":"idiom","pinyin":["wū hū āi zāi"],"definitions":["於乎：文言叹词；哉：语助词。用以指死亡或完蛋。"],"source":"《诗经·大雅·召旻》：於乎哀哉！维今之人，不尚有旧。","usage":"作谓语；含讽刺意味","similar":"呜呼哀哉","example":"战国·荀况《荀子·乐论》：乱世恶善，不此听也，～，不得成也。"},"於戏":{"char":"於戏","kind":"word","pinyin":["yú xì"],"definitions":[],"similar":"呜呼"},"於梨华":{"char":"於梨华","kind":"word","pinyin":["yú lí huá"],"definitions":["美籍华裔作家。原籍浙江镇海。女。1947年去台湾。1953年毕业于台湾大学◇留学美国加利福尼亚大学。曾在大学任教。著有长篇小说《梦回青河》、《又见棕榈，又见棕榈》，中篇小说《也是秋天》，短篇小说集《白驹集》，散文集《新中国的女性及其他》等。"]},"於菟":{"char":"於菟","kind":"word","pinyin":["wū tú"],"definitions":["古代楚人称虎。"]},"梼戭":{"char":"梼戭","kind":"word","pinyin":["táo yǎn"],"definitions":["亦作\"梼?\"。亦作\"梼演\"； 远古传说中人名。八恺之一。"]},"梼昧":{"char":"梼昧","kind":"word","pinyin":["táo mèi"],"definitions":["愚昧。多作自谦之辞。"]},"梼杌":{"char":"梼杌","kind":"word","pinyin":["táo wù"],"definitions":["传说中的凶兽名； 传说为远古的恶人\"四凶\"之一。或谓即鲧； 泛指恶人； 楚史书名。"]},"梼杌饕餮":{"char":"梼杌饕餮","kind":"idiom","pinyin":["táo wù tāo tiè"],"definitions":["梼杌、饕餮：古代传说中凶猛的野兽。比喻凶恶的人。"],"source":"明·邱濬《大学衍义补·固帮本·择民之长》：远方之民，虽使盗跖为之郡守，梼杌饕餮为之县令，郡县之民，群嘲而聚骂者，虽百千为辈，朝廷不知也。"},"梼树":{"char":"梼树","kind":"word","pinyin":["táo shù"],"definitions":["指松柏之类刚劲的树木。"]},"梼演":{"char":"梼演","kind":"word","pinyin":["táo yǎn"],"definitions":[],"similar":"梼戭"},"榼榼":{"char":"榼榼","kind":"word","pinyin":["kē kē"],"definitions":["象声词。"]},"榼榼啐啐":{"char":"榼榼啐啐","kind":"word","pinyin":["kē kē cuì cuì"],"definitions":["形容大声。"]},"榼牙料嘴":{"char":"榼牙料嘴","kind":"word","pinyin":["kē yá liào zuǐ"],"definitions":["斗嘴，争吵。"]},"榼藤":{"char":"榼藤","kind":"word","pinyin":["kē téng"],"definitions":["豆科。木质藤本。二回羽状复叶，总叶轴先端有卷须。花黄色，圆锥花序。荚果木质，长可达一米，由多数节组成，每节一种子。种子扁圆形，富含油分。藤及种子药用;纤维供造纸或制人造棉。"]},"檼栝":{"char":"檼栝","kind":"word","pinyin":["yìn guā"],"definitions":[],"similar":"檃括"},"沼吴":{"char":"沼吴","kind":"word","pinyin":["zhǎo wú"],"definitions":["犹言灭吴。语本《左传．哀公元年》\"越十年生聚，而十年教训，二十年之外，吴其为沼乎!\"杜预注\"谓吴宫室废坏，当为污池。\""]},"沼气":{"char":"沼气","kind":"word","pinyin":["zhǎo qì"],"definitions":["有机物质在与空气隔绝的条件下，经过微生物发酵而产生的一种以甲烷为主的可燃气体。因最初发现于沼泽中，故名。"]},"沼池":{"char":"沼池","kind":"word","pinyin":["zhǎo chí"],"definitions":["水池，池塘； 比喻困苦的境遇。"]},"沼沚":{"char":"沼沚","kind":"word","pinyin":["zhǎo zhǐ"],"definitions":["池塘。亦借指积水坑。"]},"沼泽":{"char":"沼泽","kind":"word","pinyin":["zhǎo zé"],"definitions":["即沼泽地”。"]},"沼泽化":{"char":"沼泽化","kind":"word","pinyin":["zhǎo zé huà"],"definitions":["存在泥炭化的土地长期过湿，在湿生作物作用或厌氧条件下进行的有机质的生物积累和矿质元素还原的过程。沼泽化土壤有机质多，植物养料的灰分元素缺乏，水分长期饱和，通气不良。排水可防止沼泽化的发生发展。"]},"沼泽土":{"char":"沼泽土","kind":"word","pinyin":["zhǎo zé tǔ"],"definitions":["在地表积水、地下水浸润和沼泽植被共同作用下形成的土壤。上部有较厚泥炭层或有机质层，下部有蓝灰色或灰色的潜育层。质地黏重。中国主要分布于东北平原和川西北高原的松潘草地。"]},"沼泽地":{"char":"沼泽地","kind":"word","pinyin":["zhǎo zé dì"],"definitions":["长期受积水浸泡，水草茂密的泥泞地区。土壤剖面上部为腐泥沼泽土或泥炭沼泽土，下部为潜育层。有机质含量高，持水性强，透水性弱，干燥时体积收缩。经排水疏干，土壤通气良好，有机物得以分解，可增加肥分。"]},"澼絖":{"char":"澼絖","kind":"word","pinyin":["pì kuàng"],"definitions":["《庄子．逍遥游》\"宋人有善为不j手之药者，世世以洴澼絖为事。客闻之，请买其方百金。聚族而谋曰'我世世为洴澼絖，不过数金;今一朝而鬻技百金，请与之。'\"后以\"澼絖\"为典，借指医治皴手的药方或小技艺。"]},"炼丹":{"char":"炼丹","kind":"word","pinyin":["liàn dān"],"definitions":["指道教徒用朱砂炼药。"]},"炼之未定":{"char":"炼之未定","kind":"idiom","pinyin":["liàn zhī wèi dìng"],"definitions":["用心琢磨，反复锤炼，决定不下来。"],"example":"我们写作经常在一些关键用词上～。","usage":"作谓语、宾语；用于写作"},"炼习":{"char":"炼习","kind":"word","pinyin":["liàn xí"],"definitions":["练习，反复学习并实践体验。"]},"炼乳":{"char":"炼乳","kind":"word","pinyin":["liàn rǔ"],"definitions":["一种乳制品，用鲜牛奶或羊奶经消毒浓缩加糖制成，可贮存较长时间。"]},"炼养":{"char":"炼养","kind":"word","pinyin":["liàn yǎng"],"definitions":["修炼养生。"]},"炼冶":{"char":"炼冶","kind":"word","pinyin":["liàn yě"],"definitions":["指锤炼文句。"]},"炼制":{"char":"炼制","kind":"word","pinyin":["liàn zhì"],"definitions":["提练制作：～焦油。"]},"炼印":{"char":"炼印","kind":"word","pinyin":["liàn yìn"],"definitions":["戏曲传统剧目。叙革职公差杨传、李乙闻扬州萧太师横行不法，诬陷原告，乃趁新巡按陈魁回乡完婚之机，用蜡制成假印，乔装陈魁和差役，到扬州平反冤狱。陈魁到时，又于当堂炼印之时，设计以假印换真印，拿办萧、陈等后离去。闽剧整理本影响较大。"]},"炼句":{"char":"炼句","kind":"word","pinyin":["liàn jù"],"definitions":["写作时斟酌语句，使简洁优美要写好文章，还须炼字～。"]},"炼字":{"char":"炼字","kind":"word","pinyin":["liàn zì"],"definitions":["写作时推敲用字，使准确生动。"]},"炼山":{"char":"炼山","kind":"word","pinyin":["liàn shān"],"definitions":["为了造林或使森林更新，把山上的杂草、灌木或采伐剩余物用火烧掉。"]},"炼师":{"char":"炼师","kind":"word","pinyin":["liàn shī"],"definitions":["旧时以某些道士懂得\"养生\"﹑\"炼丹\"之法，尊称为\"炼师\"。"]},"炼度":{"char":"炼度","kind":"word","pinyin":["liàn dù"],"definitions":["指道士为丧家打醮礼神祈福。"]},"炼形":{"char":"炼形","kind":"word","pinyin":["liàn xíng"],"definitions":["道家谓修炼自身形体。"]},"炼思":{"char":"炼思","kind":"word","pinyin":["liàn sī"],"definitions":["指诗思。诗句须反复推敲﹐故称。"]},"炼性":{"char":"炼性","kind":"word","pinyin":["liàn xìng"],"definitions":["道教谓修炼心性。"]},"炼意":{"char":"炼意","kind":"word","pinyin":["liàn yì"],"definitions":["推敲文句﹐揣摩布局﹐以求恰切表达情意。"]},"炼指":{"char":"炼指","kind":"word","pinyin":["liàn zhǐ"],"definitions":["束香于指，以火烧灼。为僧徒修炼苦行之一。"]},"炼术":{"char":"炼术","kind":"word","pinyin":["liàn shù"],"definitions":["指道士修炼之术。"]},"炼格":{"char":"炼格","kind":"word","pinyin":["liàn gé"],"definitions":["谓锤炼作品的风格。"]},"炼气":{"char":"炼气","kind":"word","pinyin":["liàn qì"],"definitions":["道家指通过吐纳导引等以求长生的一种方法。"]},"炼汞":{"char":"炼汞","kind":"word","pinyin":["liàn gǒng"],"definitions":["指道家烧炼金石药物，以制成丹药。"]},"炼油":{"char":"炼油","kind":"word","pinyin":["liàn yóu"],"definitions":["分馏石油；用加热的方法从含油的物质中把油分离出来；把动物油或植物油加热使适于食用。"]},"炼液":{"char":