itions":["突然死亡。"]},"暴民":{"char":"暴民","kind":"word","pinyin":["bào mín"],"definitions":["参与暴动或暴乱的人。"]},"暴气":{"char":"暴气","kind":"word","pinyin":["bào qì"],"definitions":["暴躁的脾气； 嚣张的气焰。"]},"暴水":{"char":"暴水","kind":"word","pinyin":["bào shuǐ"],"definitions":["洪水； 暴发洪水。"]},"暴沓":{"char":"暴沓","kind":"word","pinyin":["bào dá"],"definitions":["残暴贪婪。"]},"暴泻":{"char":"暴泻","kind":"word","pinyin":["bào xiè"],"definitions":["中医指急性腹泻；指价格、汇率等短时间内急速、大幅度下跌：股市指数～。"]},"暴浣":{"char":"暴浣","kind":"word","pinyin":["bào huàn"],"definitions":["曝晒洗涤。谓除污去恶，使之纯洁。"]},"暴涨":{"char":"暴涨","kind":"word","pinyin":["bào zhǎng"],"definitions":["（水位）急剧上升：河水～；（物价等）在短时间内大幅度上升：新股上市，价格～。"],"similar":"猛涨","opposite":"暴跌；猛跌；猛降"},"暴涨潮":{"char":"暴涨潮","kind":"word","pinyin":["bào zhǎng cháo"],"definitions":["涌潮。"]},"暴滥":{"char":"暴滥","kind":"word","pinyin":["bào làn"],"definitions":["残暴无度。"]},"暴灭":{"char":"暴灭","kind":"word","pinyin":["bào miè"],"definitions":["犹暴蔑。"]},"暴烈":{"char":"暴烈","kind":"word","pinyin":["bào liè"],"definitions":["暴躁刚烈性情～； 凶暴猛烈～的行动。"],"similar":"凶暴；猛烈；暴躁","opposite":"温顺；温驯；温和；温柔；柔和"},"暴犷":{"char":"暴犷","kind":"word","pinyin":["bào guǎng"],"definitions":["粗暴犷悍。"]},"暴狂":{"char":"暴狂","kind":"word","pinyin":["bào kuáng"],"definitions":["凶暴狂妄。"]},"暴狠":{"char":"暴狠","kind":"word","pinyin":["bào hěn"],"definitions":["横暴凶狠。"]},"暴狱":{"char":"暴狱","kind":"word","pinyin":["bào yù"],"definitions":["指犯人在监狱中发动暴乱。"]},"暴猛":{"char":"暴猛","kind":"word","pinyin":["bào měng"],"definitions":["凶暴。"]},"暴王":{"char":"暴王","kind":"word","pinyin":["bào wáng"],"definitions":["暴虐的君王； 古亦以称亡国之君。"]},"暴疾":{"char":"暴疾","kind":"word","pinyin":["bào jí"],"definitions":["迅猛； 突然发病。"]},"暴病":{"char":"暴病","kind":"word","pinyin":["bào bìng"],"definitions":["突然发作来势很凶的病。"]},"暴白":{"char":"暴白","kind":"word","pinyin":["bào bái"],"definitions":["暴露； 显扬； 剖白。"]},"暴示":{"char":"暴示","kind":"word","pinyin":["bào shì"],"definitions":["谓暴尸示众。"]},"暴禁":{"char":"暴禁","kind":"word","pinyin":["bào jìn"],"definitions":["苛法。"]},"暴税":{"char":"暴税","kind":"word","pinyin":["bào shuì"],"definitions":["繁重的赋税。"]},"暴突":{"char":"暴突","kind":"word","pinyin":["bào tū"],"definitions":["鼓起来；突出青筋～ㄧ气得两眼～。"]},"暴章":{"char":"暴章","kind":"word","pinyin":["bào zhāng"],"definitions":[],"source":"《汉书•薛宣传》：薛宣任左冯翊太守期间，他的治下高陵令杨湛贪污受贿，他写信给杨湛说：“又念十金重法，不忍相暴章。故密以手书相晓，欲君自图进取。”十金重法，按汉律，赃值十金，可治重罪。但薛宣却采取了让他引咎辞官的办法。暴章，喻指揭露罪状。"},"暴絶":{"char":"暴絶","kind":"word","pinyin":["bào jué"],"definitions":["残害灭绝； 突然断气。"]},"暴缪":{"char":"暴缪","kind":"word","pinyin":["bào móu"],"definitions":["残暴乖谬。缪，通\"谬\"。"]},"暴背":{"char":"暴背","kind":"word","pinyin":["bào bèi"],"definitions":["曝背，晒背。"]},"暴腮龙门":{"char":"暴腮龙门","kind":"idiom","pinyin":["pù sāi lóng mén"],"definitions":["象鱼仰望龙门而不得上一样。科举时代比喻应进士试不第，后也比喻生活遭遇挫折，处境窘迫。"],"source":"《太平御览》卷四十引《辛氏三秦记》：河津一名龙门，巨灵迹犹在，去长安九百里。江海大鱼洎集门下数千，不得上，上则为龙，故云暴腮龙门。","usage":"作宾语、定语；指科举落榜","similar":"曝腮龙门","opposite":"飞黄腾达","example":"明·李贽《初潭集·师友六》：江海大鱼集门下，不得上；上即为龙。故云：‘～，垂耳辕下。’"},"暴腾":{"char":"暴腾","kind":"word","pinyin":["bào téng"],"definitions":["暴躁； 急遽上涨。"]},"暴节竹":{"char":"暴节竹","kind":"word","pinyin":["bào jié zhú"],"definitions":["即筯竹。"]},"暴苛":{"char":"暴苛","kind":"word","pinyin":["bào kē"],"definitions":["残暴苛刻。"]},"暴荒":{"char":"暴荒","kind":"word","pinyin":["bào huāng"],"definitions":["谓尸骨暴露于荒野。"]},"暴落":{"char":"暴落","kind":"word","pinyin":["bào luò"],"definitions":["急剧下降。"]},"暴蔑":{"char":"暴蔑","kind":"word","pinyin":["bào miè"],"definitions":["欺罔蔑视。"]},"暴虎":{"char":"暴虎","kind":"word","pinyin":["bào hǔ"],"definitions":["空手和老虎搏斗； 凶猛的老虎。"]},"暴虎冯河":{"char":"暴虎冯河","kind":"idiom","pinyin":["bào hǔ píng hé"],"definitions":["暴虎：空手搏虎；冯河：涉水过河。比喻有勇无谋，鲁莽冒险。"],"source":"《诗经·小雅·小旻》：“不敢暴虎，不敢冯河；人知其一，莫知其他。”《论语·述而》：暴虎冯河，死而无悔者，吾不与也。","usage":"作谓语、定语、分句；比喻有勇无谋","similar":"有勇无谋；贸然行事","opposite":"有勇有谋；谨言慎行；深谋远虑","example":"元·关汉卿《鲁斋郎》第四折：俺张孔目怎还肯缘木求鱼，鲁斋郎他可敢～？"},"暴虎凭河":{"char":"暴虎凭河","kind":"word","pinyin":["bào hǔ píng hé"],"definitions":[],"source":"《论语•述而》：孔子弟子子路很勇猛，他自以为出兵作战一定会用他。在讨论问题时，子路问孔子说，如果率领三军，先生要和谁在一起呢？孔子回答说：“暴虎凭河，死而无悔者，吾不与也。”暴虎，空手搏虎；凭河，徒步渡河。","usage":"孔子说，这种蛮干的人我是不能同他在一起的。后以“暴虎凭河”比喻为有勇无谋、冒险行事的人。唐•裴铏《韦自东》：“暴虎凭河，死而无悔。”"},"暴虐":{"char":"暴虐","kind":"word","pinyin":["bào nüè"],"definitions":["凶恶残酷～无道； 〈书〉凶恶残暴地对待～无辜ㄧ～百姓。"],"similar":"残暴","opposite":"仁慈"},"暴虐无道":{"char":"暴虐无道","kind":"idiom","pinyin":["bào nüè wú dào"],"definitions":["残暴狠毒，丧尽道义。"],"source":"《晋书·桓彝传》：遂肆意酒色，暴虐无道，多所残害。","usage":"作谓语、定语；形容人很残暴","similar":"荒淫无度；暴戾恣睢","example":"明·冯梦龙《东周列国志》第一回：到九传厉王，～，为国人所杀。"},"暴虫":{"char":"暴虫","kind":"word","pinyin":["bào chóng"],"definitions":["猛兽。"]},"暴行":{"char":"暴行","kind":"word","pinyin":["bào xíng"],"definitions":["凶恶残酷的行为：血腥～｜书中记录了侵略者烧杀掳掠的～。"]},"暴衣露冠":{"char":"暴衣露冠","kind":"idiom","pinyin":["pù yī lù guàn"],"definitions":["日晒衣裳，露湿冠冕。形容奔波劳碌。暴，晒。"],"source":"《汉书·燕刺王刘旦传》：今宗室子孙，曾无暴衣露冠之劳，裂地而王之，分财而赐之，父死子继，兄终弟及。","usage":"作宾语、定语；用于人生","example":"《史记·郦生陆贾列传》：足下甚苦，～，将兵助楚讨不义，足不何不自喜也？臣原以事见，而曰‘吾方以天下为事，未暇见儒人也’。"},"暴衣露盖":{"char":"暴衣露盖","kind":"idiom","pinyin":["pù yī lù gài"],"definitions":["日晒衣裳，露湿车盖。形容奔波劳碌。暴，晒。"],"source":"《史记·萧相国世家》：鲍生谓丞相曰：‘王暴衣露盖，数使使劳苦君者，有疑君心也。’","usage":"作谓语；用于奔波","example":"明·杨慎《丁丑封事》：陛下～，栉风沐雨，曾不顾惜此。"},"暴裂":{"char":"暴裂","kind":"word","pinyin":["bào liè"],"definitions":["胀裂。"]},"暴见":{"char":"暴见","kind":"word","pinyin":["bào jiàn"],"definitions":["显现； 犹宣扬。"]},"暴謷":{"char":"暴謷","kind":"word","pinyin":["bào áo"],"definitions":[],"similar":"暴傲\"； 凶暴傲慢;桀骜不驯。謷，通\"傲"},"暴诃":{"char":"暴诃","kind":"word","pinyin":["bào hē"],"definitions":["粗暴地呵斥。"]},"暴谩":{"char":"暴谩","kind":"word","pinyin":["bào mán"],"definitions":[],"similar":"暴慢"},"暴豪":{"char":"暴豪","kind":"word","pinyin":["bào háo"],"definitions":["凶暴强横。"]},"暴贵":{"char":"暴贵","kind":"word","pinyin":["bào guì"],"definitions":["突然显贵； 指突然显贵的人； 急遽涨价。"]},"暴赋":{"char":"暴赋","kind":"word","pinyin":["bào fù"],"definitions":["繁重的赋税。"]},"暴走":{"char":"暴走","kind":"word","pinyin":["bào zǒu"],"definitions":["指在室外长距离快速行走：为了减肥，她每天～10公里。"]},"暴起":{"char":"暴起","kind":"word","pinyin":["bào qǐ"],"definitions":["突然升起或兴起； 突然起用。"]},"暴跌":{"char":"暴跌","kind":"word","pinyin":["bào diē"],"definitions":["（物价、声誉等）大幅度下降谷价～ㄧ声价～。"]},"暴跳":{"char":"暴跳","kind":"word","pinyin":["bào tiào"],"definitions":["猛烈地跳脚，形容大怒的样子稍不如意，就～起来。"]},"暴跳如雷":{"char":"暴跳如雷","kind":"idiom","pinyin":["bào tiào rú léi"],"definitions":["暴：暴烈，急躁。急怒叫跳，象打雷一样猛烈。形容又急又怒，大发脾气的样子。"],"source":"《古诗为焦仲卿妻作》：我有亲父兄，性行暴如雷。","usage":"作谓语、状语、定语；形容人盛怒时的样子","similar":"大发雷霆；火冒三丈；气急败坏","opposite":"心平气和；奴不变容；和颜悦色","example":"清·吴趼人《二十年目睹之怪现状》第二十三回：他哥哥知道了，气得～。叫了他去骂。"},"暴蹶":{"char":"暴蹶","kind":"word","pinyin":["bào jué"],"definitions":["亦作\"暴躡\"； 突然昏厥。"]},"暴躁":{"char":"暴躁","kind":"word","pinyin":["bào zào"],"definitions":["遇事急躁，容易发怒：性情～。"],"similar":"暴烈；急躁","opposite":"温和"},"暴躁如雷":{"char":"暴躁如雷","kind":"idiom","pinyin":["bào zào rú léi"],"definitions":["暴：暴烈，急躁。急怒叫跳，象打雷一样猛烈。形容又急又怒，大发脾气的样子。"],"source":"《古诗为焦仲卿妻作》：我有亲父兄，性行暴如雷。","usage":"作谓语、定语、状语；指人的情绪","similar":"暴跳如雷","example":"清·吴敬梓《儒林外史》第六回：严贡生越发恼得～。"},"暴躡":{"char":"暴躡","kind":"word","pinyin":["bào niè"],"definitions":[],"similar":"暴蹶"},"暴身":{"char":"暴身","kind":"word","pinyin":["bào shēn"],"definitions":["犹暴尸。"]},"暴迫":{"char":"暴迫","kind":"word","pinyin":["bào pò"],"definitions":["谓过分接近。"]},"暴逆":{"char":"暴逆","kind":"word","pinyin":["bào nì"],"definitions":["暴虐，残害； 凶暴忤逆； 指凶暴忤逆的人。"]},"暴速":{"char":"暴速","kind":"word","pinyin":["bào sù"],"definitions":["急速。"]},"暴酷":{"char":"暴酷","kind":"word","pinyin":["bào kù"],"definitions":["暴虐残酷； 指暴虐残酷的人。"]},"暴钞":{"char":"暴钞","kind":"word","pinyin":["bào chāo"],"definitions":["掠夺。"]},"暴长":{"char":"暴长","kind":"word","pinyin":["bào zhǎng"],"definitions":[],"similar":"暴涨"},"暴陈":{"char":"暴陈","kind":"word","pinyin":["bào chén"],"definitions":["暴露于外。"]},"暴陵":{"char":"暴陵","kind":"word","pinyin":["bào líng"],"definitions":["欺压凌辱。"]},"暴集":{"char":"暴集","kind":"word","pinyin":["bào jí"],"definitions":["骤然聚集。"]},"暴雨":{"char":"暴雨","kind":"word","pinyin":["bào yǔ"],"definitions":["大而急的雨；气象学上指1小时内雨量在16毫米以上，或24小时内雨量在50毫米以上的雨。"]},"暴雷":{"char":"暴雷","kind":"word","pinyin":["bào léi"],"definitions":["突然而猛烈的雷。"]},"暴露":{"char":"暴露","kind":"word","pinyin":["bào lù"],"definitions":["（隐蔽的事物、缺陷、矛盾、问题等）显露出来～目标ㄧ～无遗。"],"similar":"揭露；显露；显示","opposite":"隐蔽"},"暴露文学":{"char":"暴露文学","kind":"word","pinyin":["bào lòu wén xué"],"definitions":["指只揭露社会黑暗面，而不能指出光明前景的文学作品，如清末的《官场现形记》等。"]},"暴露无遗":{"char":"暴露无遗","kind":"idiom","pinyin":["bào lù wú yí"],"definitions":["暴露：显露，显现；遗：遗漏。全都暴露出来。"],"source":"杜鹏程《保卫延安》第二章：只要在这里发现敌人主力，那敌人一切诡计就暴露无遗。","example":"蒋介石政府的卖国外交政策～。","usage":"作谓语；形容坏人坏事或社会的黑暗显露出来","similar":"图穷匕见；原形毕露；水落石出","opposite":"滴水不漏；秘而不宣；深藏若虚"},"暴面":{"char":"暴面","kind":"word","pinyin":["bào miàn"],"definitions":["犹言抛头露面。"]},"暴风":{"char":"暴风","kind":"word","pinyin":["bào fēng"],"definitions":["指猛烈而急速的风：～骤雨；气象学上旧指11级风。参看389页；。"]},"暴风疾雨":{"char":"暴风疾雨","kind":"idiom","pinyin":["bào fēng jí yǔ"],"definitions":["指来势急遽而猛烈的风雨。"],"source":"《清史稿·灾异志三》：[同治]三年六月初十日，定海暴风疾雨，坏各埠船，溺死兵民无数。","usage":"作主语、宾语；形容雨很大","similar":"暴风骤雨","opposite":"和风细雨","example":"郑振铎《海燕》：小小的燕子，浩莽的大海，飞着飞着，不会觉得倦么？不会遇着～么？我们真替它们担心呢！"},"暴风雨":{"char":"暴风雨","kind":"word","pinyin":["bào fēng yǔ"],"definitions":["大而急的风雨 ◇革命的～。"]},"暴风雪":{"char":"暴风雪","kind":"word","pinyin":["bào fēng xuě"],"definitions":["大而急的风雪。有的地区叫白毛风。"]},"暴风骤雨":{"char":"暴风骤雨","kind":"idiom","pinyin":["bào fēng zhòu yǔ"],"definitions":["暴、骤：急速，突然。又猛又急的大风雨。比喻声势浩大，发展急速而猛烈。"],"source":"《老子》第二十三章：故飘风不终朝，骤雨不终日。","usage":"作主语、宾语；形容迅疾而猛烈的风雨","similar":"狂风暴雨；急风暴雨","opposite":"和风细雨；东风化雨","example":"明·吴承恩《西游记》第六十九回：有雌雄二鸟，原在一处同飞，忽被～惊散。"},"暴饮暴食":{"char":"暴饮暴食","kind":"idiom","pinyin":["bào yǐn bào shí"],"definitions":["又猛又急地大量吃喝，使身体失调。"],"source":"王朔《我是你爸爸》：长得单薄这可不是一朝一夕能改变的，即使从现在起就牛肉牛奶地暴饮暴食，换出一身牛力气也得寒暑几载。","example":"～对人身体不利。","usage":"作主语、宾语、定语；指不注意饮食卫生","similar":"大吃大喝"},"暴首":{"char":"暴首","kind":"word","pinyin":["bào shǒu"],"definitions":["谓陈列所得敌人首级。"]},"暴骜":{"char":"暴骜","kind":"word","pinyin":["bào ào"],"definitions":["暴傲。凶暴傲慢。骜，通\"傲\"。"]},"暴骨":{"char":"暴骨","kind":"word","pinyin":["bào gǔ"],"definitions":["暴露尸骨。指死于郊野； 指暴露的尸骨。"]},"暴骸":{"char":"暴骸","kind":"word","pinyin":["bào hái"],"definitions":["暴露尸骸； 指暴露的尸骸。"]},"暴鳃":{"char":"暴鳃","kind":"word","pinyin":["bào sāi"],"definitions":[],"similar":"曝鳃"},"暴鳃龙门":{"char":"暴鳃龙门","kind":"word","pinyin":["bào sāi lóng mén"],"definitions":[],"source":"宋•李昉《太平御览》：引《辛氏三秦记》：“河津一名龙门（今山西河津西北，韩城市东北。），……水悬船而行，旁有山，水陆不通，龟鱼之属莫能上。江海大鱼洎集门下数千，不得上。上则为龙。故云曝鳃龙门。”曝，本作“暴”。暴鳃龙门，比喻受到挫折或科举应试不中。唐•高适《高常侍集》：“一夕洛空，生灵悲暴鳃。”"},"暴鳞":{"char":"暴鳞","kind":"word","pinyin":["bào lín"],"definitions":["暴鳃的鱼。喻失意者。"]},"暴鼓":{"char":"暴鼓","kind":"word","pinyin":["bào gǔ"],"definitions":["方言。倾家荡产的意思。"]},"梴梴":{"char":"梴梴","kind":"word","pinyin":["chān chān"],"definitions":["木长貌； 绵长貌。"]},"榴子":{"char":"榴子","kind":"word","pinyin":["liú zi"],"definitions":["石榴的子实。"]},"榴实":{"char":"榴实","kind":"word","pinyin":["liú shí"],"definitions":["石榴的果实。"]},"榴弹":{"char":"榴弹","kind":"word","pinyin":["liú dàn"],"definitions":["一种依靠炸药爆炸后产生的碎片、冲击波来杀伤或摧毁目标的炮弹；泛指手榴弹、枪榴弹和用炮发射的榴弹等。"]},"榴弹炮":{"char":"榴弹炮","kind":"word","pinyin":["liú dàn pào"],"definitions":["炮身较短、初速小、弹道弯曲的火炮，可用来射击各种地形上不同性质的目标。"]},"榴房":{"char":"榴房","kind":"word","pinyin":["liú fáng"],"definitions":["石榴房中多子，用喻祝人多子之意。"]},"榴梿":{"char":"榴梿","kind":"word","pinyin":["liú lián"],"definitions":["常绿乔木，叶子长椭圆形。果实球形，表面有很多硬刺，果肉白色，可以吃，原产马来群岛；这种植物的果实；也作榴莲。"]},"榴榴":{"char":"榴榴","kind":"word","pinyin":["liú liú"],"definitions":["象声词。"]},"榴火":{"char":"榴火","kind":"word","pinyin":["liú huǒ"],"definitions":["石榴花的火红的颜色。"]},"榴环台":{"char":"榴环台","kind":"word","pinyin":["liú huán tái"],"definitions":["台名。三国吴孙权所建。"]},"榴皮字":{"char":"榴皮字","kind":"word","pinyin":["liú pí zì"],"definitions":["指宋时回道人以石榴皮题诗于湖州归安东林隐士沈思(即沈东老)庵壁事。"]},"榴红":{"char":"榴红","kind":"word","pinyin":["liú hóng"],"definitions":["石榴花似的红色。"]},"榴花":{"char":"榴花","kind":"word","pinyin":["liú huā"],"definitions":["石榴花； 据《南史．夷貊传上．扶南国》载，顿逊国有酒树似安石榴，采其花汁停瓮中，数日成酒◇以\"榴花\"雅称美酒。"]},"榴花樽":{"char":"榴花樽","kind":"word","pinyin":["liú huā zūn"],"definitions":["犹榴花酒。借指酒。"]},"榴莲":{"char":"榴莲","kind":"word","pinyin":["liú lián"],"definitions":["常绿乔木。叶子长椭圆形，表面光滑，背面生鳞片。果实球形，表面有很多硬刺，果肉味美，为热带著名果品之一。原产马来西亚，我国广东﹑海南也有。"]},"榴裙":{"char":"榴裙","