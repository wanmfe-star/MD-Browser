:{"char":"念念不舍","kind":"idiom","pinyin":["niàn niàn bù shě"],"definitions":["念念：一遍遍地思念。时刻思念，永不忘记。"],"source":"梁启超《节本明儒学案·忠宪高景逸先生攀龙》：立坐食息，念念不舍。","usage":"作谓语、宾语、状语；指时刻挂在心上","similar":"念念不忘"},"念念不释":{"char":"念念不释","kind":"idiom","pinyin":["niàn niàn bù shì"],"definitions":["念念：时刻思念着。形容牢记于心，时刻不忘。"],"source":"元·苏天爵《元朝名臣事略·左丞许文正公》：丞相安图素闻先生名，心慕之，乃就访于行馆。及还，心悦诚服，念念不释者累日。","example":"钱钟书《围城》第五章：告诉你罢，我第一次碰到你以后，倒常常想你，～地恨你，可惜我没有看表，计算时间。"},"念念呢呢":{"char":"念念呢呢","kind":"word","pinyin":["niàn niàn ne ne"],"definitions":["形容说话含糊不清。"]},"念念有词":{"char":"念念有词","kind":"idiom","pinyin":["niàn niàn yǒu cí"],"definitions":["念念：不停地念诵。旧指迷信的人祈祷时不停地念着口语，以通神灵。现多用来形容人嘟嘟囔囔说个不停。"],"source":"明·施耐庵《水浒全传》第八十六回：贺统军见折了两个兄弟，便口中念念有词，作起妖法。","usage":"作谓语；含有讽刺诙谐意味","similar":"振振有词；涛涛不绝","opposite":"默不做声；沉默寡言","example":"清·禇人获《隋唐演义》第八十四回：至三更时，仗剑步罡，焚符一道，口中～，把令牌一拍，只见李邕忽从壁间步出。"},"念思":{"char":"念思","kind":"word","pinyin":["niàn sī"],"definitions":["怀念； 考虑。"]},"念恋":{"char":"念恋","kind":"word","pinyin":["niàn liàn"],"definitions":["思念爱恋。"]},"念恤":{"char":"念恤","kind":"word","pinyin":["niàn xù"],"definitions":["挂念忧虑。"]},"念想":{"char":"念想","kind":"word","pinyin":["niàn xiǎng"],"definitions":["想念。"]},"念想儿":{"char":"念想儿","kind":"word","pinyin":["niàn xiǎng ér"],"definitions":["纪念品。也说念心儿。"]},"念旧":{"char":"念旧","kind":"word","pinyin":["niàn jiù"],"definitions":["挂念旧人;不忘故旧。"]},"念旧怜才":{"char":"念旧怜才","kind":"idiom","pinyin":["niàn jiù lián cái"],"definitions":["旧：老交谊；怜：怜爱。思念旧谊，爱惜贤才。"],"source":"清·袁枚《小仓山房尺牍》第156首：方知大君子之念旧怜才，迥出寻常万万。","usage":"作谓语、宾语；指为人"},"念曲":{"char":"念曲","kind":"word","pinyin":["niàn qū"],"definitions":["谓唱歌而声无抑扬。"]},"念望":{"char":"念望","kind":"word","pinyin":["niàn wàng"],"definitions":["愿望，希望。"]},"念殃":{"char":"念殃","kind":"word","pinyin":["niàn yāng"],"definitions":[],"similar":"念秧"},"念物":{"char":"念物","kind":"word","pinyin":["niàn wù"],"definitions":["纪念品。"]},"念珠":{"char":"念珠","kind":"word","pinyin":["niàn zhū"],"definitions":["亦称\"念佛珠\"； 念佛号或经咒时用以计数的串珠。用材不一，粒数有十八﹑二十七﹑五十四﹑一百零八之分。"]},"念珠曹":{"char":"念珠曹","kind":"wo